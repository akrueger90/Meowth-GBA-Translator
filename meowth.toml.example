[translation]
# Translation provider. "local" downloads a free offline model on first use.
# Remote options: deepseek, openai, google, groq, mistral, openrouter,
# siliconflow, zhipu, moonshot, qwen, anthropic
provider = "local"
model = "argos-opus"
source_language = "en"
target_language = "zh-Hans"
# Editable term and phrase overrides; created automatically on first run.
terminology_file = "~/.meowth/terminology.toml"
# PokeAPI/glossary is always tried first; the provider handles missing entries.
llm_for_tables = true

# Remote providers only:
# [translation.api]
# key_env = "DEEPSEEK_API_KEY"
# base_url = "https://api.deepseek.com/v1"

[output]
dir = "outputs"
cache_dir = "work/cache"
